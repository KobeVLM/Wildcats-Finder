	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Generic success status validation based on method",
					"pm.test(\"Status code is successful for \" + pm.request.method, function () {",
					"    const method = pm.request.method;",
					"    const code = pm.response.code;",
					"    const successCodesByMethod = {",
					"        GET: [200, 206],",
					"        POST: [200, 201, 202],",
					"        PUT: [200, 204],",
					"        PATCH: [200, 204],",
					"        DELETE: [200, 202, 204],",
					"        HEAD: [200, 204],",
					"        OPTIONS: [200, 204]",
					"    };",
					"    const expected = successCodesByMethod[method] || [200];",
					"    pm.expect(code, \"Expected one of: \" + expected.join(\", \")).to.be.oneOf(expected);",
					"});",
					"",
					"// Try to parse JSON safely",
					"function tryParseJson(body) {",
					"    try { return JSON.parse(body); } catch (e) { return null; }",
					"}",
					"",
					"// Heuristics to infer expected properties by endpoint pattern",
					"function inferExpectedProps(req) {",
					"    const urlPath = req.url.getPath();",
					"    const method = req.method;",
					"",
					"    // Normalize path for checks",
					"    const p = urlPath.toLowerCase();",
					"",
					"    // Common resource hints",
					"    const isList = method === 'GET' && /\\/(list|all|search|query|categories|items|products|users|claims)(\\/|$)/.test(p) && !\\/[0-9a-f-]+$/.test(p);",
					"    const isGetById = method === 'GET' && /\\/(categories|items|products|users|claims)\\/(\\d+|[0-9a-f-]+)(\\/|$)/.test(p);",
					"    const isCreate = method === 'POST';",
					"    const isUpdate = method === 'PUT' || method === 'PATCH';",
					"    const isDelete = method === 'DELETE';",
					"",
					"    if (isList) {",
					"        return { type: 'array', required: [] };",
					"    }",
					"    if (isGetById) {",
					"        return { type: 'object', required: [\"id\"] };",
					"    }",
					"    if (isCreate) {",
					"        return { type: 'object', oneOfRequired: [\"id\", \"_id\", \"uuid\"] };",
					"    }",
					"    if (isUpdate) {",
					"        return { type: 'objectOrEmpty', optional: [\"updatedAt\", \"id\"] };",
					"    }",
					"    if (isDelete) {",
					"        return { type: 'maybeEmpty' };",
					"    }",
					"    // Fallback generic expectation",
					"    return { type: 'any' };",
					"}",
					"",
					"// Validate response body shape and key presence",
					"pm.test(\"Response body contains expected properties\", function () {",
					"    const props = inferExpectedProps(pm.request);",
					"    const body = pm.response.text();",
					"    const json = tryParseJson(body);",
					"    if (props.type === 'array') {",
					"        pm.expect(Array.isArray(json), \"Expected an array response\").to.be.true;",
					"    } else if (props.type === 'object') {",
					"        pm.expect(json && typeof json === 'object' && !Array.isArray(json), \"Expected an object response\").to.be.true;",
					"        if (props.required) {",
					"            props.required.forEach(function (key) {",
					"                pm.expect(json, \"Expected property '\" + key + \"'\").to.have.property(key);",
					"            });",
					"        }",
					"        if (props.oneOfRequired) {",
					"            pm.expect(",
					"                props.oneOfRequired.some(function (key) { return json && json.hasOwnProperty(key); }),",
					"                \"Expected at least one of: \" + props.oneOfRequired.join(\", \")",
					"            ).to.be.true;",
					"        }",
					"    } else if (props.type === 'objectOrEmpty') {",
					"        pm.expect(json === null || (typeof json === 'object' && !Array.isArray(json)), \"Expected object or empty response\").to.be.true;",
					"    } else if (props.type === 'maybeEmpty') {",
					"        pm.expect(json === null || typeof json === 'object', \"Expected empty or object response\").to.be.true;",
					"    }",
					"    // No assertion for 'any' type",
					"});"
				]
			}
		}
	]
